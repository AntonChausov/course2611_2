
#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);

КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура РассчитатьСуммуСтроки(Строка)

	Строка.Сумма = Строка.Количество * Строка.Цена;
	Сотрудник = ОписаниеЧеловека();
	Сообщить(Сотрудник.Имя);

КонецПроцедуры

&НаКлиенте
Функция ОписаниеЧеловека()
	
	Человек = Новый Структура;
	Человек.Вставить("Имя", "Антон");
	Человек.Вставить("СтажЛет", 15);
	Человек.Вставить("Штатный", Истина);
	Человек.Вставить("ДатаПриема", ТекущаяДата());
	Человек.Вставить("ДатаУвольнения", Дата(1,1,1));
	Человек.Вставить("Должность", "Руководитель");
	Человек.Вставить("Подразделение", "Отдел продаж");
	Человек.Вставить("Зарплата", 100000);
	Человек.Вставить("Телефон", "+7(999)1234567");
	Человек.Вставить("Адрес", "г. Москва, ул. Ленина, д. 1");
	Человек.Вставить("Пол", "Мужской");
	Человек.Вставить("ДатаРождения", Дата(1980,1,1));
	Человек.Вставить("МестоРождения", "г. Москва");
	Человек.Вставить("Гражданство", "Россия");


	Возврат Человек;

КонецФункции
	