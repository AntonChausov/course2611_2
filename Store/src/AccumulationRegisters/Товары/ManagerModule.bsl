
// Функция возвращает остаток по переданной номенклатуре в виде соответствия, где ключ - склад, а значение - количество остатка на данном складе
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура, остатки которой необходимо получить
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - где ключ - склад, а значение - количество остатка на данном складе:
//   * Ключ - Строка - склад
//   * Значение - Число - количество остатка на данном складе
//
// Пример:
//  ОстатокНоменклатуры(Номенклатура) - Соответствие Из КлючИЗначение - где ключ - склад, а значение - количество остатка на данном складе:
//   * Ключ - Строка - склад
//   * Значение - Число - количество остатка на данном складе
//
Функция ОстатокНоменклатуры(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыОстатки.Склад КАК Склад,
		|	ТоварыОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.Товары.Остатки(, Номенклатура = &Номенклатура) КАК ТоварыОстатки";

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Результат = Запрос.Выполнить().Выбрать();
	Остатки = Новый Соответствие;
	Пока Результат.Следующий() Цикл
		Остатки.Вставить(Результат.Склад, Результат.Количество);
	КонецЦикла;

	Возврат Остатки;

КонецФункции // ОстатокНоменклатуры()